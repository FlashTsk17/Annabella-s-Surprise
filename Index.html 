<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pour toi, Annabella ✨</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --midnight:#06030f;
  --deep-plum:#12072a;
  --plum:#1a0a35;
  --violet:#2a1050;
  --rose-gold:#c9899a;
  --rose-light:#e8c0cc;
  --gold:#c9a227;
  --gold-light:#e8c87a;
  --ivory:#f5f0ea;
  --lavender:#d4c5e8;
  --text-main:#f0e8f5;
  --text-soft:rgba(240,232,245,0.68);
  --text-dim:rgba(240,232,245,0.32);
}
html,body{width:100%;height:100%;overflow:hidden;background:var(--midnight);font-family:'Jost',sans-serif;color:var(--text-main)}
#canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}
.bg-layer{position:fixed;inset:0;z-index:1;opacity:0;transition:opacity 1.8s ease;pointer-events:none}
.bg-layer.active{opacity:1}
#bg-0{background:radial-gradient(ellipse at 50% 60%,#200a45 0%,var(--midnight) 70%)}
#bg-1{background:radial-gradient(ellipse at 35% 50%,#1e0a40 0%,var(--midnight) 65%)}
#bg-2{background:radial-gradient(ellipse at 65% 45%,#2a0a28 0%,var(--midnight) 65%)}
#bg-3{background:radial-gradient(ellipse at 50% 50%,#180838 0%,var(--midnight) 65%)}
#bg-4{background:radial-gradient(ellipse at 40% 55%,#1e0828 0%,var(--midnight) 65%)}
#bg-5{background:radial-gradient(ellipse at 50% 40%,#100520 0%,var(--midnight) 70%)}
.gradient-overlay{position:fixed;inset:0;z-index:2;background:radial-gradient(ellipse at top,rgba(201,137,154,0.05) 0%,transparent 55%),radial-gradient(ellipse at bottom,rgba(201,162,39,0.04) 0%,transparent 55%);pointer-events:none}
.scene{position:fixed;top:0;left:0;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10;opacity:0;pointer-events:none;transition:opacity 1.4s ease;padding:2.5rem}
.scene.active{opacity:1;pointer-events:all}

/* ENTRY */
#scene-entry{cursor:pointer}
.entry-glow{position:absolute;width:480px;height:480px;border-radius:50%;background:radial-gradient(circle,rgba(201,162,39,0.07) 0%,transparent 70%);animation:pulse-glow 4s ease-in-out infinite;pointer-events:none}
@keyframes pulse-glow{0%,100%{transform:scale(1);opacity:0.5}50%{transform:scale(1.15);opacity:1}}
.entry-tag{font-family:'Jost',sans-serif;font-weight:200;letter-spacing:.45em;font-size:.6rem;color:var(--gold);text-transform:uppercase;margin-bottom:3rem;opacity:0;animation:fade-up 1.5s ease .5s forwards}
.entry-name{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,8vw,5rem);font-weight:300;font-style:italic;color:var(--text-main);letter-spacing:.12em;margin-bottom:.5rem;opacity:0;animation:fade-up 1.5s ease .9s forwards}
.entry-msg{font-family:'Jost',sans-serif;font-weight:200;font-size:clamp(.75rem,2vw,.88rem);letter-spacing:.15em;color:var(--text-soft);text-align:center;margin-bottom:3.5rem;line-height:1.8;opacity:0;animation:fade-up 1.5s ease 1.3s forwards}
.btn-enter{display:inline-flex;align-items:center;gap:.9rem;padding:.9rem 2.8rem;border:1px solid rgba(201,162,39,.35);background:rgba(201,162,39,.05);color:var(--gold-light);font-family:'Jost',sans-serif;font-weight:300;font-size:.75rem;letter-spacing:.28em;text-transform:uppercase;cursor:pointer;border-radius:2px;transition:all .4s ease;opacity:0;animation:fade-up 1.5s ease 1.7s forwards;position:relative;overflow:hidden;outline:none}
.btn-enter::before{content:'';position:absolute;inset:0;background:rgba(201,162,39,.09);transform:translateX(-100%);transition:transform .4s ease}
.btn-enter:hover::before{transform:translateX(0)}
.btn-enter:hover{border-color:rgba(201,162,39,.65)}
.entry-line{width:1px;height:60px;background:linear-gradient(to bottom,transparent,var(--gold),transparent);margin:0 auto 2.5rem;opacity:0;animation:fade-up 1.5s ease 1.1s forwards}

/* SCENE 1 - NAME */
#scene-1{gap:.5rem}
.name-reveal{font-family:'Cormorant Garamond',serif;font-size:clamp(3.5rem,11vw,8rem);font-weight:300;letter-spacing:.18em;text-align:center;line-height:1}
.letter{display:inline-block;opacity:0;transform:translateY(25px);transition:opacity .5s ease,transform .5s ease}
.letter.visible{opacity:1;transform:translateY(0)}
.golden-line{width:0;height:1px;background:linear-gradient(to right,transparent,var(--gold),transparent);margin:1.8rem auto;transition:width 1s ease}
.golden-line.visible{width:80px}
.scene1-sub{font-family:'Jost',sans-serif;font-weight:200;font-size:clamp(.65rem,2vw,.8rem);letter-spacing:.4em;color:var(--text-soft);text-transform:uppercase;text-align:center;opacity:0;transition:opacity 1.2s ease}
.scene1-sub.visible{opacity:1}

/* SCENE 2 - MESSAGE */
#scene-2{flex-direction:row;gap:5rem;max-width:880px;margin:0 auto}
@media(max-width:680px){#scene-2{flex-direction:column;gap:2.5rem;padding:2rem}}
.photo-container{flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:1rem}
.photo-outer{position:relative;width:150px;height:150px}
.photo-ring{position:absolute;inset:-10px;border-radius:50%;border:1px solid rgba(201,162,39,.2);animation:rotate-ring 18s linear infinite}
.photo-ring::before{content:'✦';position:absolute;top:-7px;left:50%;transform:translateX(-50%);color:var(--gold);font-size:.55rem}
@keyframes rotate-ring{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
.photo-frame{width:150px;height:150px;border-radius:50%;overflow:hidden;border:2px solid rgba(201,162,39,.45);box-shadow:0 0 30px rgba(201,162,39,.18),0 0 60px rgba(201,137,154,.1);animation:photo-glow 3.5s ease-in-out infinite}
@keyframes photo-glow{0%,100%{box-shadow:0 0 25px rgba(201,162,39,.18),0 0 50px rgba(201,137,154,.08)}50%{box-shadow:0 0 45px rgba(201,162,39,.32),0 0 80px rgba(201,137,154,.2)}}
.photo-frame img{width:100%;height:100%;object-fit:cover;filter:brightness(1.08) contrast(1.05) saturate(1.1)}
.photo-label{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.85rem;color:var(--rose-light);opacity:.7;letter-spacing:.08em}
.message-content{flex:1}
.message-greeting{font-family:'Cormorant Garamond',serif;font-size:clamp(1.6rem,4vw,2.4rem);font-weight:300;font-style:italic;color:var(--rose-light);margin-bottom:1.5rem;opacity:0;transform:translateX(25px);transition:all .9s ease}
.message-content.visible .message-greeting{opacity:1;transform:translateX(0)}
.message-text{font-family:'Jost',sans-serif;font-weight:300;font-size:clamp(.82rem,2vw,.93rem);line-height:2;color:var(--text-soft);opacity:0;transform:translateX(25px);transition:all .9s ease .35s}
.message-content.visible .message-text{opacity:1;transform:translateX(0)}
.message-text em{color:var(--gold-light);font-style:italic}
.msg-divider{width:40px;height:1px;background:linear-gradient(to right,var(--gold),transparent);margin:1.4rem 0;opacity:0;transition:opacity .9s ease .55s}
.message-content.visible .msg-divider{opacity:1}
.message-signature{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:1.15rem;color:var(--gold);opacity:0;transition:opacity .9s ease .7s}
.message-content.visible .message-signature{opacity:1}

/* SCENE 3 - REVELATION */
#scene-3{text-align:center}
.reveal-eyebrow{font-family:'Jost',sans-serif;font-weight:200;letter-spacing:.5em;font-size:.58rem;color:var(--gold);text-transform:uppercase;margin-bottom:2.2rem;opacity:0;transform:translateY(12px);transition:all .9s ease}
#scene-3.active .reveal-eyebrow{opacity:1;transform:translateY(0)}
.reveal-title{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,5.5vw,4rem);font-weight:300;line-height:1.15;color:var(--text-main);margin-bottom:0;max-width:680px;opacity:0;transform:translateY(18px);transition:all .9s ease .3s}
#scene-3.active .reveal-title{opacity:1;transform:translateY(0)}
.reveal-deco{width:0;height:1px;background:linear-gradient(to right,transparent,var(--gold),transparent);margin:2rem auto;transition:width 1s ease .6s}
#scene-3.active .reveal-deco{width:70px}
.reveal-subtitle{font-family:'Jost',sans-serif;font-weight:200;font-size:clamp(.8rem,2vw,.95rem);color:var(--rose-light);letter-spacing:.08em;max-width:480px;line-height:2;opacity:0;transition:opacity .9s ease .75s}
#scene-3.active .reveal-subtitle{opacity:1}

/* SCENE 4 - PILLARS */
#scene-4{text-align:center}
.pillars-eyebrow{font-family:'Jost',sans-serif;font-weight:200;letter-spacing:.4em;font-size:.58rem;color:var(--rose-gold);text-transform:uppercase;margin-bottom:1rem;opacity:0;transition:opacity .8s ease}
#scene-4.active .pillars-eyebrow{opacity:1}
.pillars-title{font-family:'Cormorant Garamond',serif;font-size:clamp(1.1rem,3vw,1.7rem);font-weight:300;font-style:italic;color:var(--text-soft);margin-bottom:2.8rem;opacity:0;transition:opacity .8s ease .2s}
#scene-4.active .pillars-title{opacity:1}
.pillars-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;max-width:680px;width:100%}
@media(max-width:500px){.pillars-grid{grid-template-columns:1fr;max-width:340px}}
.pillar{padding:1.6rem 1.4rem;border:1px solid rgba(201,162,39,.12);background:rgba(201,162,39,.03);border-radius:3px;text-align:left;opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease,border-color .3s ease;position:relative;overflow:hidden}
.pillar::before{content:'';position:absolute;top:0;left:0;width:2px;height:0;background:linear-gradient(to bottom,var(--gold),var(--rose-gold));transition:height .8s ease}
#scene-4.active .pillar::before{height:100%}
#scene-4.active .pillar:nth-child(1){opacity:1;transform:translateY(0);transition-delay:.25s}
#scene-4.active .pillar:nth-child(2){opacity:1;transform:translateY(0);transition-delay:.45s}
#scene-4.active .pillar:nth-child(3){opacity:1;transform:translateY(0);transition-delay:.65s}
#scene-4.active .pillar:nth-child(4){opacity:1;transform:translateY(0);transition-delay:.85s}
.pillar:hover{border-color:rgba(201,162,39,.28);background:rgba(201,162,39,.05)}
.pillar-icon{color:var(--gold);font-size:.85rem;margin-bottom:.6rem;display:block;transition:transform .3s ease}
.pillar:hover .pillar-icon{transform:scale(1.2)}
.pillar-text{font-family:'Jost',sans-serif;font-weight:300;font-size:clamp(.82rem,2vw,.9rem);line-height:1.6;color:var(--text-main)}

/* SCENE 5 - CLOSING */
#scene-5{text-align:center;gap:0}
.closing-line1{font-family:'Cormorant Garamond',serif;font-size:clamp(.9rem,2.5vw,1.2rem);font-weight:300;font-style:italic;color:var(--text-dim);letter-spacing:.08em;margin-bottom:2.5rem;opacity:0;transition:opacity 1s ease}
#scene-5.active .closing-line1{opacity:1}
.closing-quote{font-family:'Cormorant Garamond',serif;font-size:clamp(1.5rem,4.5vw,2.8rem);font-weight:300;line-height:1.5;color:var(--text-main);max-width:620px;margin-bottom:2.5rem;opacity:0;transition:opacity 1.1s ease .35s}
#scene-5.active .closing-quote{opacity:1}
.closing-deco{display:flex;align-items:center;gap:1rem;margin-bottom:2.5rem;opacity:0;transition:opacity 1s ease .7s}
#scene-5.active .closing-deco{opacity:1}
.closing-deco::before,.closing-deco::after{content:'';flex:1;max-width:60px;height:1px;background:linear-gradient(to right,transparent,rgba(201,162,39,.4))}
.closing-deco::after{background:linear-gradient(to left,transparent,rgba(201,162,39,.4))}
.closing-deco span{color:var(--gold);font-size:.6rem}
.closing-action{font-family:'Jost',sans-serif;font-weight:300;font-size:clamp(.9rem,2.5vw,1.1rem);color:var(--rose-light);letter-spacing:.06em;margin-bottom:2rem;opacity:0;transition:opacity 1s ease .9s}
#scene-5.active .closing-action{opacity:1}
.closing-sig{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-style:italic;color:var(--gold);opacity:0;transition:opacity 1.2s ease 1.2s}
#scene-5.active .closing-sig{opacity:1}

/* NAV */
.nav-dots{position:fixed;bottom:2.2rem;left:50%;transform:translateX(-50%);display:flex;gap:.55rem;z-index:100;opacity:0;transition:opacity .6s ease}
.dot{width:5px;height:5px;border-radius:50%;background:rgba(201,162,39,.25);transition:all .4s ease;cursor:pointer}
.dot.active{background:var(--gold);width:20px;border-radius:3px}
.click-hint{position:fixed;bottom:4.8rem;left:50%;transform:translateX(-50%);font-family:'Jost',sans-serif;font-weight:200;font-size:.55rem;letter-spacing:.35em;text-transform:uppercase;color:var(--text-dim);z-index:100;animation:fade-blink 2.5s ease-in-out infinite;white-space:nowrap;opacity:0;transition:opacity .6s ease}
@keyframes fade-blink{0%,100%{opacity:.25}50%{opacity:.65}}
@keyframes fade-up{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
</style>
</head>
<body>

<div id="bg-0" class="bg-layer active"></div>
<div id="bg-1" class="bg-layer"></div>
<div id="bg-2" class="bg-layer"></div>
<div id="bg-3" class="bg-layer"></div>
<div id="bg-4" class="bg-layer"></div>
<div id="bg-5" class="bg-layer"></div>
<div class="gradient-overlay"></div>
<canvas id="canvas"></canvas>

<!-- ENTRY -->
<div id="scene-entry" class="scene active">
  <div class="entry-glow"></div>
  <div class="entry-tag">Un message personnel t'attend</div>
  <div class="entry-name">Annabella</div>
  <div class="entry-line"></div>
  <div class="entry-msg">Quelqu'un a pensé à toi.<br>Et a créé quelque chose, juste pour toi.</div>
  <button class="btn-enter" id="btnEnter">
    <span>✦</span>&nbsp;Découvrir&nbsp;<span>✦</span>
  </button>
</div>

<!-- SCENE 1 - NAME REVEAL -->
<div id="scene-1" class="scene">
  <div class="name-reveal" id="nameReveal"></div>
  <div class="golden-line" id="goldenLine"></div>
  <div class="scene1-sub" id="scene1Sub">Cette page n'existe que pour toi.</div>
</div>

<!-- SCENE 2 - MESSAGE PERSONNEL -->
<div id="scene-2" class="scene">
  <div class="photo-container">
    <div class="photo-outer">
      <div class="photo-ring"></div>
      <div class="photo-frame">
        <img id="profileImg" alt="Annabella">
      </div>
    </div>
    <div class="photo-label">Annabella Roliana</div>
  </div>
  <div class="message-content" id="msgContent">
    <div class="message-greeting">Annabella,</div>
    <div class="message-text">
      Tu as un regard sur la mode que peu de gens possèdent naturellement.<br><br>
      Cette façon de créer, de donner de l'âme à un tissu,<br>
      de <em>voir les choses autrement</em>…<br><br>
      J'ai décidé de ne pas garder ça pour moi.<br><br>
      Alors plutôt que de te le dire simplement,<br>
      j'ai préféré te <em>montrer</em> ce que je vois en toi.
    </div>
    <div class="msg-divider"></div>
    <div class="message-signature">— Tsadok</div>
  </div>
</div>

<!-- SCENE 3 - REVELATION -->
<div id="scene-3" class="scene">
  <div class="reveal-eyebrow">Pour toi · Annabella Roliana · 2026</div>
  <div class="reveal-title">J'ai travaillé sur quelque chose pour toi.</div>
  <div class="reveal-deco" id="revealDeco"></div>
  <div class="reveal-subtitle">
    Une identité. Une présence.<br>
    Un avenir dans la mode afro-moderne.<br><br>
    Voici ce que j'ai imaginé pour toi.
  </div>
</div>

<!-- SCENE 4 - PILLARS -->
<div id="scene-4" class="scene">
  <div class="pillars-eyebrow">Le plan · Pour toi</div>
  <div class="pillars-title">Ce qui t'attend…</div>
  <div class="pillars-grid">
    <div class="pillar">
      <span class="pillar-icon">✦</span>
      <div class="pillar-text">Une identité de marque forte</div>
    </div>
    <div class="pillar">
      <span class="pillar-icon">✦</span>
      <div class="pillar-text">Une stratégie de présence en ligne</div>
    </div>
    <div class="pillar">
      <span class="pillar-icon">✦</span>
      <div class="pillar-text">Un plan pour décrocher ton job</div>
    </div>
    <div class="pillar">
      <span class="pillar-icon">✦</span>
      <div class="pillar-text">Les bases d'une future marque</div>
    </div>
  </div>
</div>

<!-- SCENE 5 - CLOSING -->
<div id="scene-5" class="scene">
  <div class="closing-line1">Un mot pour finir…</div>
  <div class="closing-quote">
    "La mode n'est pas juste ce qu'on porte.<br>
    C'est ce qu'on dit sans parler."<br><br>
    Et toi, Annabella…<br>
    tu as <em style="color:var(--gold-light)">tellement</em> à dire.
  </div>
  <div class="closing-deco"><span>✦</span></div>
  <div class="closing-action">La suite, on la construit ensemble. ✨</div>
  <div class="closing-sig">— Tsadok</div>
</div>

<!-- UI -->
<div class="click-hint" id="clickHint">Appuyer pour continuer</div>
<div class="nav-dots" id="navDots">
  <div class="dot active" data-scene="1"></div>
  <div class="dot" data-scene="2"></div>
  <div class="dot" data-scene="3"></div>
  <div class="dot" data-scene="4"></div>
  <div class="dot" data-scene="5"></div>
</div>

<script>
// ── IMAGE ──────────────────────────────────────────────────────────
const IMG_DATA = '';
document.getElementById('profileImg').src = 'data:image/jpeg;base64,' + IMG_DATA;

// ── STATE ──────────────────────────────────────────────────────────
let currentScene = 0;
let audioCtx = null;
let musicOn = false;
const TOTAL = 5;
const scenes  = ['scene-entry','scene-1','scene-2','scene-3','scene-4','scene-5'];
const bgs     = ['bg-0','bg-1','bg-2','bg-3','bg-4','bg-5'];

// ── SCENE ENGINE ───────────────────────────────────────────────────
function showScene(idx) {
  scenes.forEach((id, i) => {
    document.getElementById(id).classList.toggle('active', i === idx);
    document.getElementById(bgs[i]).classList.toggle('active', i === idx);
  });
  document.querySelectorAll('.dot').forEach((d, i) => d.classList.toggle('active', i === idx - 1));
  const nav   = document.getElementById('navDots');
  const hint  = document.getElementById('clickHint');
  nav.style.opacity  = idx > 0 ? '1' : '0';
  hint.style.opacity = (idx > 0 && idx < TOTAL) ? '1' : '0';
  triggerAnimations(idx);
}

function goTo(idx) {
  currentScene = idx;
  showScene(idx);
}

// ── ANIMATIONS PER SCENE ───────────────────────────────────────────
function triggerAnimations(idx) {
  if (idx === 1) animateName();
  if (idx === 2) setTimeout(() => document.getElementById('msgContent').classList.add('visible'), 350);
}

function animateName() {
  const name = 'Annabella';
  const container = document.getElementById('nameReveal');
  container.innerHTML = '';
  name.split('').forEach((ch, i) => {
    const s = document.createElement('span');
    s.className = 'letter';
    s.textContent = ch;
    container.appendChild(s);
    setTimeout(() => s.classList.add('visible'), 220 + i * 130);
  });
  setTimeout(() => document.getElementById('goldenLine').classList.add('visible'), 220 + name.length * 130 + 400);
  setTimeout(() => document.getElementById('scene1Sub').classList.add('visible'), 220 + name.length * 130 + 900);
}

// ── ENTRY ─────────────────────────────────────────────────────────
function startExperience() {
  startMusic();
  goTo(1);
}

document.getElementById('btnEnter').addEventListener('click', startExperience);
document.getElementById('scene-entry').addEventListener('click', (e) => {
  if (e.target !== document.getElementById('btnEnter')) startExperience();
});

// Click / tap to advance
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('dot')) return;
  if (e.target.id === 'btnEnter') return;
  if (currentScene > 0 && currentScene < TOTAL) goTo(currentScene + 1);
});

document.addEventListener('keydown', (e) => {
  if (['ArrowRight','Space','Enter'].includes(e.code)) {
    if (currentScene === 0) { startExperience(); return; }
    if (currentScene < TOTAL) goTo(currentScene + 1);
  }
});

document.querySelectorAll('.dot').forEach(d => {
  d.addEventListener('click', (e) => {
    e.stopPropagation();
    goTo(parseInt(d.dataset.scene));
  });
});

// ── PARTICLES ─────────────────────────────────────────────────────
const canvas = document.getElementById('canvas');
const ctx    = canvas.getContext('2d');
let particles = [];

function resize() { canvas.width = innerWidth; canvas.height = innerHeight; }
resize(); window.addEventListener('resize', resize);

function mkParticle() {
  return {
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    size: Math.random() * 1.4 + .3,
    vx: (Math.random() - .5) * .25,
    vy: -Math.random() * .35 - .08,
    alpha: Math.random() * .45 + .08,
    life: 0,
    max: Math.random() * 280 + 180,
    gold: Math.random() > .45
  };
}

for (let i = 0; i < 90; i++) { const p = mkParticle(); p.life = Math.random() * p.max; particles.push(p); }

function drawParticles() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  particles.forEach((p, i) => {
    p.life++; p.x += p.vx; p.y += p.vy;
    const t = p.life / p.max;
    const a = t < .2 ? (t/.2)*p.alpha : t > .8 ? ((1-t)/.2)*p.alpha : p.alpha;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
    ctx.fillStyle = p.gold ? `rgba(201,162,39,${a})` : `rgba(201,137,154,${a})`;
    ctx.fill();
    if (p.life >= p.max) particles[i] = mkParticle();
  });
  requestAnimationFrame(drawParticles);
}
drawParticles();

// ── AMBIENT MUSIC ─────────────────────────────────────────────────
function startMusic() {
  if (musicOn) return;
  musicOn = true;
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();

  const master = audioCtx.createGain();
  master.gain.setValueAtTime(0, audioCtx.currentTime);
  master.gain.linearRampToValueAtTime(.22, audioCtx.currentTime + 5);
  master.connect(audioCtx.destination);

  // Reverb
  const len = audioCtx.sampleRate * 4;
  const buf = audioCtx.createBuffer(2, len, audioCtx.sampleRate);
  for (let ch = 0; ch < 2; ch++) {
    const d = buf.getChannelData(ch);
    for (let i = 0; i < len; i++) d[i] = (Math.random()*2-1)*Math.pow(1-i/len, 1.6);
  }
  const rev = audioCtx.createConvolver(); rev.buffer = buf;
  const revG = audioCtx.createGain(); revG.gain.value = .55;
  rev.connect(revG); revG.connect(master);

  // Pads – A minor
  [[110,.11],[164.81,.065],[220,.055],[261.63,.038],[329.63,.028]].forEach(([f,g]) => {
    const o = audioCtx.createOscillator();
    const gn = audioCtx.createGain();
    const lfo = audioCtx.createOscillator();
    const lfog = audioCtx.createGain();
    o.type = 'sine'; o.frequency.value = f; gn.gain.value = g;
    lfo.frequency.value = .25; lfog.gain.value = f*.0025;
    lfo.connect(lfog); lfog.connect(o.frequency);
    o.connect(gn); gn.connect(master); gn.connect(rev);
    o.start(); lfo.start();
  });

  // Arpeggio – A minor pentatonic ascending
  const arp = [440,523.25,587.33,659.25,783.99,880,783.99,659.25,587.33,523.25];
  let ni = 0;
  function playArp() {
    const f = arp[ni++ % arp.length];
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine'; o.frequency.value = f;
    const t = audioCtx.currentTime;
    g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(.055,t+.18);
    g.gain.exponentialRampToValueAtTime(.001,t+2.8);
    o.connect(g); g.connect(master); g.connect(rev);
    o.start(t); o.stop(t+2.8);
  }
  setTimeout(playArp, 2200);
  setInterval(playArp, 1300);

  // Shimmer (high)
  const shimmerPool = [1318.51,1174.66,1046.5,880,987.77];
  function shimmer() {
    const f = shimmerPool[Math.floor(Math.random()*shimmerPool.length)];
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine'; o.frequency.value = f;
    const t = audioCtx.currentTime;
    g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(.022,t+.12);
    g.gain.exponentialRampToValueAtTime(.001,t+3.2);
    o.connect(g); g.connect(rev);
    o.start(t); o.stop(t+3.2);
  }
  setTimeout(shimmer,3500);
  setInterval(shimmer, 3800+Math.random()*2200);
}
</script>
